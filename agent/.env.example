# LiveKit Cloud project credentials (https://cloud.livekit.io -> Settings -> Keys).
# LIVEKIT_URL must match the one the bridge hands to the app.
LIVEKIT_URL=wss://YOUR_PROJECT.livekit.cloud
LIVEKIT_API_KEY=
LIVEKIT_API_SECRET=

# Beyond Presence (https://docs.bey.dev/api-key). The avatar id is on your agent
# in the Beyond Presence studio; leave it blank to use their stock avatar.
BEY_API_KEY=
BEY_AVATAR_ID=694c83e2-8895-4a98-bd16-56332ca3f449

# Where the Next.js bridge is reachable from this worker.
LEARNSPHERE_API_URL=http://127.0.0.1:3000

# Optional LiveKit Inference model overrides (defaults work for English).
# TUTOR_STT_MODEL=deepgram/nova-3
# TUTOR_LLM_MODEL=google/gemma-4-31b-it
# TUTOR_TTS_MODEL=inworld/inworld-tts-2
# TUTOR_TTS_VOICE=Ashley
#
# Per-locale TTS/STT is chosen by the bridge from dispatch metadata (see api/src/lib/app-language.ts).
# Override defaults above only if you want a single voice for all sessions.
