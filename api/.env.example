NEXT_PUBLIC_SUPABASE_URL=https://YOUR_PROJECT.supabase.co
NEXT_PUBLIC_SUPABASE_ANON_KEY=your-anon-key

GROQ_API_KEY=
GROQ_CHAT_MODEL=llama-3.3-70b-versatile
GROQ_TRANSCRIPTION_MODEL=whisper-large-v3-turbo

GEMINI_API_KEY=
GEMINI_EMBEDDING_MODEL=gemini-embedding-001
GEMINI_EMBEDDING_DIMENSIONS=1536

# Live tutor transport. Create a free project at https://cloud.livekit.io and use
# the same three values in agent/.env.local.
LIVEKIT_URL=wss://YOUR_PROJECT.livekit.cloud
LIVEKIT_API_KEY=
LIVEKIT_API_SECRET=

# Landing download: leave unset so /api/download/android resolves the newest
# GitHub release APK. Do NOT set this to the /releases list page.
# ANDROID_DOWNLOAD_URL=https://github.com/knurdz/learn-sphere/releases/download/v0.2.4/learn-sphere-v0.2.4.apk
# ANDROID_GITHUB_REPO=knurdz/learn-sphere
# GITHUB_TOKEN=
