# Production bridge (Docker reads these at runtime — prefer SUPABASE_* over NEXT_PUBLIC_* only)
SUPABASE_URL=https://YOUR_PROJECT.supabase.co
SUPABASE_ANON_KEY=your-anon-key

# Optional duplicates (local Next dev); same values as above
NEXT_PUBLIC_SUPABASE_URL=https://YOUR_PROJECT.supabase.co
NEXT_PUBLIC_SUPABASE_ANON_KEY=your-anon-key

# Public HTTPS origin used for asset URLs (meme templates) sent to the app.
# Falls back to the X-Forwarded-* headers Caddy sets.
PUBLIC_BASE_URL=https://learnsphere.knurdz.org

# Microsoft Foundry (OpenAI-compatible). Model names should match your deployments.
FOUNDRY_OPENAI_ENDPOINT=https://YOUR-RESOURCE.openai.azure.com/openai/v1
FOUNDRY_API_KEY=
FOUNDRY_CHAT_MODEL=gpt-4.1-mini
FOUNDRY_TRANSCRIPTION_MODEL=gpt-4o-mini-transcribe
FOUNDRY_EMBEDDING_MODEL=text-embedding-3-large
FOUNDRY_EMBEDDING_DIMENSIONS=1536

# Live tutor transport. Create a free project at https://cloud.livekit.io and use
# the same three values in agent.env on the VM.
LIVEKIT_URL=wss://YOUR_PROJECT.livekit.cloud
LIVEKIT_API_KEY=
LIVEKIT_API_SECRET=

# Landing download — leave ANDROID_DOWNLOAD_URL unset so the site always
# redirects to the newest GitHub release APK. Optional GITHUB_TOKEN avoids
# anonymous API rate limits on the VM.
# GITHUB_TOKEN=
# ANDROID_GITHUB_REPO=knurdz/learn-sphere
# ANDROID_DOWNLOAD_URL=https://github.com/knurdz/learn-sphere/releases/download/v0.2.4/learn-sphere-v0.2.4.apk

