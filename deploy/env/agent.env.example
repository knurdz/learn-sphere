# LiveKit Cloud project credentials (https://cloud.livekit.io -> Settings -> Keys).
LIVEKIT_URL=wss://YOUR_PROJECT.livekit.cloud
LIVEKIT_API_KEY=
LIVEKIT_API_SECRET=

# Beyond Presence (https://docs.bey.dev/api-key)
BEY_API_KEY=
BEY_AVATAR_ID=

# Overridden in docker-compose to http://api:3000 on the internal network.
LEARNSPHERE_API_URL=http://api:3000
