# Copy to supabase/.env.local (gitignored). Used by `supabase config push`.
# Do not commit real values.

# Google OAuth (Web client from Google Cloud Console)
SUPABASE_AUTH_EXTERNAL_GOOGLE_CLIENT_ID=
SUPABASE_AUTH_EXTERNAL_GOOGLE_SECRET=

# Custom SMTP (Supabase Auth → sends signup / password-reset OTP emails)
SMTP_HOST=
SMTP_PORT=587
SMTP_USER=
SMTP_PASS=
# If the password contains # or spaces, wrap it in double quotes, e.g. SMTP_PASS="p@ss#word"
SMTP_ADMIN_EMAIL=
